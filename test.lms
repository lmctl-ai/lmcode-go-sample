# Run from this repository: lmctl test.lms or lmscript test.lms.
import "./sample-suite/runner-lib.lms";
root = suite_root();
fn step(command) {
  result = invoke(suite_root(), command, [], {}, 600000);
  if (result.stdout != "") { print(result.stdout); }
  if (result.stderr != "") { print(result.stderr); }
  assert(result.code == 0 && result.error == "", "test step failed: " + json_stringify(command) + " " + result.error);
}
python = "python3";
if (env("RUNNER_OS") == "Windows") { python = "python"; }
step([python, "-B", "scripts/sync-suite.py", "--check"]);
step([python, "-B", "sample-suite/test_return_protocol.py"]);
step(["go", "mod", "verify"]);
step([python, "-B", "scripts/test-return-controls.py"]);
set_env("CGO_ENABLED", "0");
mkdir("build");
host = path_join(Directory, "build/lmcode-go-sample");
if (env("RUNNER_OS") == "Windows") { host = host + ".exe"; }
version = env("SAMPLE_VERSION") || "0.4.0";
step(["go", "build", "-trimpath", "-ldflags=-buildid= -X main.version=" + version, "-o", host, "."]);
sdk = invoke(root, ["go", "list", "-m", "-f", "{{.Dir}}", "github.com/lmctl-ai/lmcode-go"], [], {}, 30000);
assert(sdk.code == 0, "cannot locate pinned SDK");
std = path_join(trim(sdk.stdout), "std/lmcode-std.schema.json");
step(concat(compiler_command(), ["sample-suite/audit.lms", "--std", std]));
step(concat(compiler_command(), ["sample-suite/run-suite.lms", host]));
step(concat(compiler_command(), ["sample-suite/check-recompile.lms"]));
step(concat(compiler_command(), ["sample-suite/test-runner.lms"]));
# Public examples construct opaque programs and execute them through this host.
step(concat(compiler_command(), ["examples/rule-entries.lms", path_join(Directory, "build/lmcode-go-sample") ]));
step(concat(compiler_command(), ["examples/text-template.lms", path_join(Directory, "build/lmcode-go-sample") ]));
step([python, "sample-suite/check-invocations.py", path_join(Directory, "build/lmcode-go-sample")]);
step([python, "scripts/mutate-invocations.py", path_join(Directory, "build/lmcode-go-sample")]);
step([python, "scripts/test-dry-mode.py", path_join(Directory, "build/lmcode-go-sample")]);
